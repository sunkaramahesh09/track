# ---------------------------------------------------------------------------
# Copy to .env.local for local development, and set the same variables in
# Vercel → Project → Settings → Environment Variables for the deployment.
# ---------------------------------------------------------------------------

# MongoDB Atlas (hosted). Get this from Atlas → Cluster → Connect → Drivers.
# Replace <password> with your database user's password, URL-encoding any
# special characters (@ becomes %40, # becomes %23, and so on).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Local MongoDB instead, if you prefer:
# MONGODB_URI="mongodb://127.0.0.1:27017/placement-os"

# Database name. Set explicitly because Atlas URIs usually omit it, and the
# driver would otherwise fall back to "test".
MONGODB_DB="placement-os"

# The timezone the app's calendar runs in. Vercel functions run in UTC, so this
# must name your actual zone or "today" will roll over at the wrong hour.
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"
